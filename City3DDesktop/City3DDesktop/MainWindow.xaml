<Window x:Class="City3DDesktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="城市3D场景生成器"
        Height="800" Width="1400"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部工具栏 -->
        <Border Grid.Row="0" Background="{StaticResource PrimaryBrush}" Padding="16">
            <DockPanel>
                <TextBlock Text="🏙️ 城市3D场景生成器"
                          Foreground="White"
                          VerticalAlignment="Center"
                          FontSize="22"
                          FontWeight="Medium"/>
            </DockPanel>
        </Border>

        <!-- 主内容区域 -->
        <Grid Grid.Row="1" Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="350"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧面板 - 输入控制 -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- 图片加载卡片 -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="图片加载" FontSize="16" FontWeight="Medium" Margin="0,0,0,12"/>

                            <TextBox x:Name="PathInput"
                                     Style="{StaticResource ModernTextBox}"
                                     Margin="0,0,0,12"/>

                            <Button Style="{StaticResource ModernButton}"
                                    Height="40"
                                    Margin="0,0,0,12"
                                    Click="LoadImage_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📁 " FontSize="16" Margin="0,0,4,0"/>
                                    <TextBlock Text="加载图片"/>
                                </StackPanel>
                            </Button>

                            <!-- 图片预览 -->
                            <Border BorderBrush="#E0E0E0"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Height="180"
                                    Background="#FAFAFA">
                                <Image x:Name="PreviewImage" Stretch="Uniform"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- GPS坐标卡片 -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="GPS 坐标" FontSize="16" FontWeight="Medium" Margin="0,0,0,12"/>

                            <TextBlock Text="纬度 (Latitude)" Margin="0,0,0,4" Foreground="{StaticResource SecondaryTextBrush}"/>
                            <TextBox x:Name="LatInput"
                                     Style="{StaticResource ModernTextBox}"
                                     Text="31.2304"
                                     Margin="0,0,0,12"/>

                            <TextBlock Text="经度 (Longitude)" Margin="0,0,0,4" Foreground="{StaticResource SecondaryTextBrush}"/>
                            <TextBox x:Name="LonInput"
                                     Style="{StaticResource ModernTextBox}"
                                     Text="121.4737"
                                     Margin="0,0,0,12"/>

                            <TextBlock Text="查询半径" FontSize="14" Margin="0,0,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="RadiusSlider"
                                        Grid.Column="0"
                                        Minimum="100"
                                        Maximum="800"
                                        Value="300"
                                        TickFrequency="100"
                                        TickPlacement="BottomRight"
                                        Margin="0,0,12,0"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding ElementName=RadiusSlider, Path=Value, StringFormat={}{0:F0} m}"
                                           VerticalAlignment="Center"
                                           FontWeight="Medium"
                                           MinWidth="60"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 生成场景卡片 -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Button x:Name="GenerateBtn"
                                    Style="{StaticResource AccentButton}"
                                    Height="48"
                                    FontSize="16"
                                    Margin="0,0,0,12"
                                    Click="GenerateScene_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⚡ " FontSize="20" Margin="0,0,4,0"/>
                                    <TextBlock Text="生成城市场景" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <ProgressBar x:Name="ProgressBar"
                                         IsIndeterminate="True"
                                         Height="4"
                                         Visibility="Collapsed"
                                         Margin="0,0,0,12"/>

                            <TextBlock Text="场景名称" Margin="0,0,0,4" Foreground="{StaticResource SecondaryTextBrush}"/>
                            <TextBox x:Name="SceneNameInput"
                                     Style="{StaticResource ModernTextBox}"
                                     Text="我的场景"
                                     Margin="0,0,0,12"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0"
                                        Content="💾 保存场景"
                                        Style="{StaticResource OutlinedButton}"
                                        Margin="0,0,6,0"
                                        Click="SaveScene_Click"/>
                                <Button Grid.Column="1"
                                        Content="⭐ 收藏位置"
                                        Style="{StaticResource OutlinedButton}"
                                        Margin="6,0,0,0"
                                        Click="SaveLocation_Click"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- 中间面板 - 3D视图占位 -->
            <Border Grid.Column="1" Style="{StaticResource Card}">
                <Grid>
                    <Border Background="#FAFAFA" CornerRadius="4">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="🏗️"
                                      FontSize="80"
                                      HorizontalAlignment="Center"
                                      Margin="0,0,0,24"/>
                            <TextBlock Text="3D 场景视图"
                                       FontSize="24"
                                       FontWeight="Light"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="生成场景后将在此显示"
                                       FontSize="14"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       HorizontalAlignment="Center"
                                       Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- 右侧面板 - 列表 -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- 收藏位置卡片 -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="📍 收藏位置"
                                       FontSize="16"
                                       FontWeight="Medium"
                                       Margin="0,0,0,12"/>

                            <ListBox x:Name="LocationsList"
                                     Height="200"
                                     BorderThickness="0"
                                     Background="Transparent">
                            </ListBox>
                        </StackPanel>
                    </Border>

                    <!-- 保存场景卡片 -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="💾 保存场景"
                                       FontSize="16"
                                       FontWeight="Medium"
                                       Margin="0,0,0,12"/>

                            <ListBox x:Name="ScenesList"
                                     Height="300"
                                     BorderThickness="0"
                                     Background="Transparent">
                            </ListBox>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- 底部状态栏 -->
        <Border Grid.Row="2" Background="#E0E0E0" Padding="16,8">
            <DockPanel>
                <TextBlock Text="ℹ️ " FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock x:Name="StatusText"
                           Text="请输入图片路径并生成城市场景"
                           VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
