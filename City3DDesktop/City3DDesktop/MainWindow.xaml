<Window x:Class="City3DDesktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hx="http://helix-toolkit.org/wpf"
        Title="图片转3D模型工具"
        Height="800" Width="1400"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部工具栏 -->
        <Border Grid.Row="0" Background="{StaticResource PrimaryBrush}" Padding="20,12">
            <DockPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🎨"
                              FontSize="24"
                              VerticalAlignment="Center"
                              Margin="0,0,12,0"/>
                    <TextBlock Text="图片转3D模型工具"
                              Foreground="White"
                              VerticalAlignment="Center"
                              FontSize="20"
                              FontWeight="Medium"/>
                    <TextBlock Text="Image to 3D Model Converter"
                              Foreground="#E0D0FF"
                              VerticalAlignment="Center"
                              FontSize="11"
                              Margin="12,4,0,0"/>
                </StackPanel>
                <Button Content="⚙️ 设置"
                        DockPanel.Dock="Right"
                        HorizontalAlignment="Right"
                        Background="Transparent"
                        Foreground="White"
                        BorderThickness="1"
                        BorderBrush="White"
                        Padding="12,4"
                        Click="Settings_Click"/>
            </DockPanel>
        </Border>

        <!-- 主内容区域 -->
        <Grid Grid.Row="1" Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧操作面板 -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <!-- 步骤1: 上传图片 -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,12">
                                <Border Background="{StaticResource PrimaryBrush}"
                                        Width="24" Height="24"
                                        CornerRadius="12"
                                        Margin="0,0,8,0">
                                    <TextBlock Text="1"
                                              Foreground="White"
                                              FontWeight="Bold"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="选择图片"
                                          FontSize="16"
                                          FontWeight="Medium"
                                          VerticalAlignment="Center"/>
                            </DockPanel>

                            <Button Style="{StaticResource ModernButton}"
                                    Height="44"
                                    Margin="0,0,0,12"
                                    Click="LoadImage_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📁 " FontSize="18" Margin="0,0,4,0"/>
                                    <TextBlock Text="选择图片文件" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <TextBlock x:Name="ImagePathText"
                                       Text="未选择图片"
                                       FontSize="11"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       Margin="0,0,0,8"/>

                            <!-- 图片预览 -->
                            <Border BorderBrush="#E0E0E0"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Height="220"
                                    Background="#FAFAFA">
                                <Grid>
                                    <TextBlock x:Name="ImagePlaceholder"
                                              Text="🖼️"
                                              FontSize="60"
                                              Foreground="#BDBDBD"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                                    <Image x:Name="PreviewImage" Stretch="Uniform"/>
                                </Grid>
                            </Border>

                            <TextBlock Text="支持: JPG, PNG, BMP格式"
                                       FontSize="11"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       Margin="0,8,0,0"
                                       TextAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- 步骤2: 生成3D模型 -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,12">
                                <Border Background="{StaticResource PrimaryBrush}"
                                        Width="24" Height="24"
                                        CornerRadius="12"
                                        Margin="0,0,8,0">
                                    <TextBlock Text="2"
                                              Foreground="White"
                                              FontWeight="Bold"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="生成3D模型"
                                          FontSize="16"
                                          FontWeight="Medium"
                                          VerticalAlignment="Center"/>
                            </DockPanel>

                            <TextBlock Text="AI引擎"
                                       FontSize="12"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       Margin="0,0,0,4"/>
                            <ComboBox x:Name="AiProviderCombo"
                                      Padding="8"
                                      Margin="0,0,0,12"
                                      SelectedIndex="0">
                                <ComboBoxItem Content="演示模式 (本地生成示例)" Tag="Demo"/>
                                <ComboBoxItem Content="Tripo3D (云端高质量)" Tag="Tripo3D"/>
                                <ComboBoxItem Content="Meshy.ai (云端高质量)" Tag="Meshy"/>
                            </ComboBox>

                            <Button x:Name="GenerateBtn"
                                    Style="{StaticResource AccentButton}"
                                    Height="48"
                                    FontSize="16"
                                    Margin="0,0,0,12"
                                    Click="Generate_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="✨ " FontSize="20" Margin="0,0,4,0"/>
                                    <TextBlock Text="生成3D模型" VerticalAlignment="Center" FontWeight="Medium"/>
                                </StackPanel>
                            </Button>

                            <ProgressBar x:Name="GenerateProgress"
                                         Height="6"
                                         Minimum="0" Maximum="100"
                                         Visibility="Collapsed"/>
                            <TextBlock x:Name="ProgressText"
                                       FontSize="11"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       Margin="0,4,0,0"
                                       Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>

                    <!-- 步骤3: 导出模型 -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,12">
                                <Border Background="{StaticResource PrimaryBrush}"
                                        Width="24" Height="24"
                                        CornerRadius="12"
                                        Margin="0,0,8,0">
                                    <TextBlock Text="3"
                                              Foreground="White"
                                              FontWeight="Bold"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="导出模型"
                                          FontSize="16"
                                          FontWeight="Medium"
                                          VerticalAlignment="Center"/>
                            </DockPanel>

                            <TextBlock Text="导出格式"
                                       FontSize="12"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       Margin="0,0,0,4"/>
                            <ComboBox x:Name="ExportFormatCombo"
                                      Padding="8"
                                      Margin="0,0,0,12"
                                      SelectedIndex="0">
                                <ComboBoxItem Content="OBJ - 通用3D格式 (推荐)" Tag="OBJ"/>
                                <ComboBoxItem Content="STL - 3D打印格式" Tag="STL"/>
                                <ComboBoxItem Content="glTF - Web 3D标准" Tag="GLTF"/>
                                <ComboBoxItem Content="FBX - 行业标准" Tag="FBX"/>
                            </ComboBox>

                            <Button x:Name="ExportBtn"
                                    Style="{StaticResource OutlinedButton}"
                                    Height="44"
                                    IsEnabled="False"
                                    Click="Export_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="💾 " FontSize="16" Margin="0,0,4,0"/>
                                    <TextBlock Text="导出到文件" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Border Background="#FFF8E1"
                                    BorderBrush="#FFC107"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="10"
                                    Margin="0,12,0,0">
                                <TextBlock Text="💡 导出后可在 Blender、3ds Max、Maya、Cinema 4D 等3D软件中编辑"
                                          FontSize="11"
                                          Foreground="#5D4037"
                                          TextWrapping="Wrap"/>
                            </Border>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- 右侧3D预览区域 -->
            <Border Grid.Column="1" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 预览工具栏 -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="🎮 3D 模型预览"
                                  FontSize="14"
                                  FontWeight="Medium"
                                  VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal"
                                   HorizontalAlignment="Right"
                                   DockPanel.Dock="Right">
                            <Button Content="🔄 重置视角"
                                    Style="{StaticResource OutlinedButton}"
                                    Padding="8,4"
                                    Margin="4,0"
                                    Click="ResetView_Click"/>
                            <Button Content="🎨 切换显示"
                                    Style="{StaticResource OutlinedButton}"
                                    Padding="8,4"
                                    Margin="4,0"
                                    Click="ToggleWireframe_Click"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- HelixToolkit 3D 视图 -->
                    <Border Grid.Row="1"
                            Background="#1a1a2e"
                            CornerRadius="4"
                            ClipToBounds="True">
                        <Grid>
                            <hx:HelixViewport3D x:Name="Viewport3D"
                                                Background="#1a1a2e"
                                                ShowFrameRate="True"
                                                ShowCoordinateSystem="True"
                                                ZoomExtentsWhenLoaded="True">
                                <hx:HelixViewport3D.DefaultCamera>
                                    <PerspectiveCamera Position="5,5,5"
                                                      LookDirection="-5,-5,-5"
                                                      UpDirection="0,1,0"
                                                      FieldOfView="60"/>
                                </hx:HelixViewport3D.DefaultCamera>
                                <hx:DefaultLights/>
                                <hx:GridLinesVisual3D Width="20" Length="20" MinorDistance="1" MajorDistance="5" Thickness="0.01"/>
                                <ModelVisual3D x:Name="ModelContainer"/>
                            </hx:HelixViewport3D>

                            <!-- 空状态提示 -->
                            <StackPanel x:Name="EmptyState"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"
                                       IsHitTestVisible="False">
                                <TextBlock Text="🏗️"
                                          FontSize="80"
                                          Foreground="#A0A0C0"
                                          HorizontalAlignment="Center"
                                          Margin="0,0,0,16"/>
                                <TextBlock Text="3D 模型预览"
                                          FontSize="20"
                                          FontWeight="Light"
                                          Foreground="White"
                                          HorizontalAlignment="Center"/>
                                <TextBlock Text="选择图片并生成3D模型后将在此显示"
                                          FontSize="12"
                                          Foreground="#A0A0C0"
                                          HorizontalAlignment="Center"
                                          Margin="0,8,0,0"/>
                            </StackPanel>

                            <!-- 操作提示 -->
                            <Border Background="#80000000"
                                    CornerRadius="4"
                                    Padding="8"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom"
                                    Margin="8">
                                <StackPanel>
                                    <TextBlock Text="🖱️ 操作说明" Foreground="White" FontSize="10" FontWeight="Medium"/>
                                    <TextBlock Text="左键拖拽：旋转" Foreground="#C0C0D0" FontSize="10"/>
                                    <TextBlock Text="右键拖拽：平移" Foreground="#C0C0D0" FontSize="10"/>
                                    <TextBlock Text="滚轮：缩放" Foreground="#C0C0D0" FontSize="10"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- 底部状态栏 -->
        <Border Grid.Row="2" Background="#E0E0E0" Padding="16,8">
            <DockPanel>
                <TextBlock Text="ℹ️ " FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock x:Name="StatusText"
                           Text="就绪 - 请选择图片开始"
                           VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
