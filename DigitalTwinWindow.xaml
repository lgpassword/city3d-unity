<Window x:Class="City3DDesktop.DigitalTwinWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hx="http://helix-toolkit.org/wpf"
        Title="数字孪生 - 北京中心区域"
        Height="900" Width="1600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部工具栏 -->
        <Border Grid.Row="0" Background="{StaticResource PrimaryBrush}" Padding="16,10">
            <DockPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🏙️"
                              FontSize="22"
                              VerticalAlignment="Center"
                              Margin="0,0,10,0"/>
                    <TextBlock Text="数字孪生 - 北京中心区域"
                              Foreground="White"
                              VerticalAlignment="Center"
                              FontSize="18"
                              FontWeight="Medium"/>
                    <TextBlock Text="Digital Twin Visualization"
                              Foreground="#E0D0FF"
                              VerticalAlignment="Center"
                              FontSize="11"
                              Margin="12,4,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal"
                           DockPanel.Dock="Right"
                           HorizontalAlignment="Right">
                    <!-- 加载数据按钮 -->
                    <Button Content="📂 加载数据"
                            Background="Transparent"
                            Foreground="White"
                            BorderThickness="1"
                            BorderBrush="White"
                            Padding="12,6"
                            Margin="4,0"
                            Click="LoadData_Click"/>
                    <!-- 图层开关 -->
                    <Button Content="🗂️ 图层"
                            Background="Transparent"
                            Foreground="White"
                            BorderThickness="1"
                            BorderBrush="White"
                            Padding="12,6"
                            Margin="4,0"
                            Click="ToggleLayers_Click"/>
                    <!-- 视角切换 -->
                    <ComboBox x:Name="ViewAngleCombo"
                              Width="120"
                              Margin="4,0"
                              SelectedIndex="0"
                              SelectionChanged="ViewAngle_Changed">
                        <ComboBoxItem Content="透视视角" Tag="Perspective"/>
                        <ComboBoxItem Content="俯视视角" Tag="TopDown"/>
                        <ComboBoxItem Content="正面视角" Tag="Front"/>
                        <ComboBoxItem Content="侧面视角" Tag="Side"/>
                    </ComboBox>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 主内容区域 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="280"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧面板：图层控制 + 统计信息 -->
            <Border Grid.Column="0" Style="{StaticResource Card}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- 图层控制 -->
                        <TextBlock Text="图层控制"
                                  FontSize="14"
                                  FontWeight="Medium"
                                  Margin="0,0,0,12"/>

                        <CheckBox x:Name="LayerBuildings"
                                  Content="🏢 建筑"
                                  IsChecked="True"
                                  Margin="0,4"
                                  FontSize="13"
                                  Checked="Layer_Changed"
                                  Unchecked="Layer_Changed"/>
                        <CheckBox x:Name="LayerRoads"
                                  Content="🛣️ 道路"
                                  IsChecked="True"
                                  Margin="0,4"
                                  FontSize="13"
                                  Checked="Layer_Changed"
                                  Unchecked="Layer_Changed"/>
                        <CheckBox x:Name="LayerWater"
                                  Content="💧 水域"
                                  IsChecked="True"
                                  Margin="0,4"
                                  FontSize="13"
                                  Checked="Layer_Changed"
                                  Unchecked="Layer_Changed"/>
                        <CheckBox x:Name="LayerGreen"
                                  Content="🌳 绿地"
                                  IsChecked="True"
                                  Margin="0,4"
                                  FontSize="13"
                                  Checked="Layer_Changed"
                                  Unchecked="Layer_Changed"/>
                        <CheckBox x:Name="LayerPOI"
                                  Content="📍 POI"
                                  IsChecked="True"
                                  Margin="0,4"
                                  FontSize="13"
                                  Checked="Layer_Changed"
                                  Unchecked="Layer_Changed"/>

                        <!-- 分隔线 -->
                        <Separator Margin="0,16,0,12"/>

                        <!-- 统计信息 -->
                        <TextBlock Text="场景统计"
                                  FontSize="14"
                                  FontWeight="Medium"
                                  Margin="0,0,0,12"/>

                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="建筑数量" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12"/>
                            <TextBlock x:Name="StatBuildings" Grid.Column="1" Text="0" FontWeight="Medium" FontSize="12"/>
                        </Grid>
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="道路数量" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12"/>
                            <TextBlock x:Name="StatRoads" Grid.Column="1" Text="0" FontWeight="Medium" FontSize="12"/>
                        </Grid>
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="水域数量" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12"/>
                            <TextBlock x:Name="StatWater" Grid.Column="1" Text="0" FontWeight="Medium" FontSize="12"/>
                        </Grid>
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="绿地数量" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12"/>
                            <TextBlock x:Name="StatGreen" Grid.Column="1" Text="0" FontWeight="Medium" FontSize="12"/>
                        </Grid>
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="POI数量" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12"/>
                            <TextBlock x:Name="StatPOI" Grid.Column="1" Text="0" FontWeight="Medium" FontSize="12"/>
                        </Grid>

                        <!-- 分隔线 -->
                        <Separator Margin="0,16,0,12"/>

                        <!-- 渲染信息 -->
                        <TextBlock Text="渲染信息"
                                  FontSize="14"
                                  FontWeight="Medium"
                                  Margin="0,0,0,12"/>
                        <TextBlock x:Name="StatTriangles" Text="三角面: 0" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,2"/>
                        <TextBlock x:Name="StatVertices" Text="顶点数: 0" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,2"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- 中间：3D视口 -->
            <Border Grid.Column="1" Margin="4,8" CornerRadius="8" ClipToBounds="True">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#87CEEB" Offset="0"/>
                        <GradientStop Color="#B0E0E6" Offset="0.4"/>
                        <GradientStop Color="#E0F0FF" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <hx:HelixViewport3D x:Name="Viewport3D"
                                    ShowFrameRate="True"
                                    ShowCoordinateSystem="True"
                                    ZoomExtentsWhenLoaded="True"
                                    MouseDown="Viewport3D_MouseDown">
                    <hx:HelixViewport3D.DefaultCamera>
                        <PerspectiveCamera Position="0,500,500"
                                          LookDirection="0,-1,-1"
                                          UpDirection="0,1,0"
                                          FieldOfView="60"/>
                    </hx:HelixViewport3D.DefaultCamera>
                    <!-- 灯光 -->
                    <hx:SunLight/>
                    <ModelVisual3D>
                        <ModelVisual3D.Content>
                            <AmbientLight Color="#404040"/>
                        </ModelVisual3D.Content>
                    </ModelVisual3D>
                    <!-- 地面网格 -->
                    <hx:GridLinesVisual3D Width="1000" Length="1000"
                                         MinorDistance="50" MajorDistance="200"
                                         Thickness="0.5"
                                         Fill="#30000000"/>
                    <!-- 图层容器 -->
                    <ModelVisual3D x:Name="BuildingsContainer"/>
                    <ModelVisual3D x:Name="RoadsContainer"/>
                    <ModelVisual3D x:Name="WaterContainer"/>
                    <ModelVisual3D x:Name="GreenContainer"/>
                    <ModelVisual3D x:Name="POIContainer"/>
                </hx:HelixViewport3D>
            </Border>

            <!-- 右侧面板：属性信息 -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="属性面板"
                                  FontSize="14"
                                  FontWeight="Medium"
                                  Margin="0,0,0,12"/>

                        <!-- 未选中状态 -->
                        <StackPanel x:Name="NoSelectionPanel">
                            <TextBlock Text="📌"
                                      FontSize="40"
                                      HorizontalAlignment="Center"
                                      Foreground="#BDBDBD"
                                      Margin="0,20,0,8"/>
                            <TextBlock Text="点击3D场景中的对象"
                                      HorizontalAlignment="Center"
                                      Foreground="{StaticResource SecondaryTextBrush}"
                                      FontSize="12"/>
                            <TextBlock Text="查看详细属性信息"
                                      HorizontalAlignment="Center"
                                      Foreground="{StaticResource SecondaryTextBrush}"
                                      FontSize="12"
                                      Margin="0,4,0,0"/>
                        </StackPanel>

                        <!-- 选中状态 -->
                        <StackPanel x:Name="SelectionPanel" Visibility="Collapsed">
                            <Border Background="#E8EAF6" CornerRadius="4" Padding="10" Margin="0,0,0,12">
                                <TextBlock x:Name="SelectedObjectName"
                                          Text="建筑名称"
                                          FontSize="14"
                                          FontWeight="Medium"
                                          TextWrapping="Wrap"/>
                            </Border>

                            <TextBlock Text="基本信息" FontSize="12" FontWeight="Medium" Margin="0,0,0,8"/>

                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="类型:" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11"/>
                                <TextBlock x:Name="PropType" Grid.Column="1" Text="-" FontSize="11" TextWrapping="Wrap"/>
                            </Grid>
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="高度:" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11"/>
                                <TextBlock x:Name="PropHeight" Grid.Column="1" Text="-" FontSize="11"/>
                            </Grid>
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="面积:" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11"/>
                                <TextBlock x:Name="PropArea" Grid.Column="1" Text="-" FontSize="11"/>
                            </Grid>
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="坐标:" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11"/>
                                <TextBlock x:Name="PropPosition" Grid.Column="1" Text="-" FontSize="11" TextWrapping="Wrap"/>
                            </Grid>

                            <Separator Margin="0,12"/>

                            <TextBlock Text="扩展属性" FontSize="12" FontWeight="Medium" Margin="0,8,0,8"/>

                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="楼层:" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11"/>
                                <TextBlock x:Name="PropFloors" Grid.Column="1" Text="-" FontSize="11"/>
                            </Grid>
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="用途:" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11"/>
                                <TextBlock x:Name="PropUsage" Grid.Column="1" Text="-" FontSize="11" TextWrapping="Wrap"/>
                            </Grid>
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="ID:" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11"/>
                                <TextBlock x:Name="PropId" Grid.Column="1" Text="-" FontSize="11" TextWrapping="Wrap"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- 底部状态栏 -->
        <Border Grid.Row="2" Background="#E0E0E0" Padding="16,6">
            <DockPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="StatusCoord"
                              Text="坐标: 0, 0, 0"
                              VerticalAlignment="Center"
                              FontSize="11"
                              Margin="0,0,20,0"/>
                    <TextBlock x:Name="StatusZoom"
                              Text="缩放: 1.0x"
                              VerticalAlignment="Center"
                              FontSize="11"
                              Margin="0,0,20,0"/>
                    <TextBlock x:Name="StatusFPS"
                              Text="FPS: --"
                              VerticalAlignment="Center"
                              FontSize="11"
                              Margin="0,0,20,0"/>
                </StackPanel>
                <TextBlock x:Name="StatusMessage"
                          Text="就绪 - 点击「加载数据」开始"
                          VerticalAlignment="Center"
                          HorizontalAlignment="Right"
                          DockPanel.Dock="Right"
                          FontSize="11"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
